def generate(model, ids, max_new_tokens=20, eos_id=None):
    # ids: (N, P) prompt token ids
    model.reset_cache()                              
    logits = model(ids)
    finished = np.zeros(ids.shape[0], dtype=bool)

    for _ in range(max_new_tokens):
        next_id = logits[:, -1, :].argmax(-1) # (N, )

        # 1. Sequences that already finished: ignore the model's prediction
        # and just output EOS again, as filler
        if eos_id is not None:
            N = next_id.shape[0]
            for n in range(N):
                if finished[n]:
                    next_id[n] = eos_id

        # 2. Sequences that just produced EOS: mark them as finished
        for n in range(N):
            if next_id[n] == eos_id:
                finished[n] = True

        ids = np.concatenate([ids, next_id[:, None]], axis=1) # (N, current_length + 1)

        if eos_id is not None and finished.all():
            break

        logits = model(next_id[:, None]) # next_id.hape: (N,) # logit shape (N, 1, V)

    return ids